.{
    .name = .teak,
    .version = "0.1.0",
    .fingerprint = 0x2d83032a9a6b7feb, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // wgpu-native prebuilts — per-OS × per-arch, fetched lazily only
        // when a consumer calls `teak.linkNativeWgpu` for that target.
        // Pure-library consumers never pay for these. All four are
        // gfx-rs/wgpu-native v29.0.1.1; the Windows zips ship
        // `wgpu_native.dll`, the Linux zips ship `libwgpu_native.{so,a}`.
        .@"wgpu-native-windows-aarch64" = .{
            .url = "https://github.com/gfx-rs/wgpu-native/releases/download/v29.0.1.1/wgpu-windows-aarch64-msvc-release.zip",
            .hash = "N-V-__8AABCr2gO0rrDPgyURACL0DtGwkRTlbT09AZJ6lBtO",
            .lazy = true,
        },
        .@"wgpu-native-windows-x86_64" = .{
            .url = "https://github.com/gfx-rs/wgpu-native/releases/download/v29.0.1.1/wgpu-windows-x86_64-msvc-release.zip",
            .hash = "N-V-__8AAC46GAQ3sxZqmcxtw9OBe44NYXQyRJ7jp8Jy2bMQ",
            .lazy = true,
        },
        .@"wgpu-native-linux-aarch64" = .{
            .url = "https://github.com/gfx-rs/wgpu-native/releases/download/v29.0.1.1/wgpu-linux-aarch64-release.zip",
            .hash = "N-V-__8AACvXrAO11f5LA-Qfgm2C0XyWNhS_0N30HTL-Y5pQ",
            .lazy = true,
        },
        .@"wgpu-native-linux-x86_64" = .{
            .url = "https://github.com/gfx-rs/wgpu-native/releases/download/v29.0.1.1/wgpu-linux-x86_64-release.zip",
            .hash = "N-V-__8AAAVLrgM9jWFLs7n4rHyodpjIYxtBBE1No8nK0pRz",
            .lazy = true,
        },
        // macOS prebuilts (same wgpu-native release): `libwgpu_native.dylib`
        // + `.a`, Metal backend.
        .@"wgpu-native-macos-aarch64" = .{
            .url = "https://github.com/gfx-rs/wgpu-native/releases/download/v29.0.1.1/wgpu-macos-aarch64-release.zip",
            .hash = "N-V-__8AAAUNfQJBPHGd3KMhFvl4WLpzHDx9rFkwSf2rFVhr",
            .lazy = true,
        },
        .@"wgpu-native-macos-x86_64" = .{
            .url = "https://github.com/gfx-rs/wgpu-native/releases/download/v29.0.1.1/wgpu-macos-x86_64-release.zip",
            .hash = "N-V-__8AAFWheQIu8DV1xiTixrDsCJ0xr7-Ssy-XhEIkgx5u",
            .lazy = true,
        },
        // zunk (wasm build tool + web bindings), pinned to the v0.16.0 release.
        // Co-developing zunk? Build with `zig build --fork=../zunk` to use a
        // local checkout instead of this pin (see CLAUDE.md, "zunk").
        .zunk = .{
            .url = "git+https://github.com/hotschmoe/zunk.git#663dbd7dbe9082e1db3e64e9745289c75783db5d",
            .hash = "zunk-0.16.0-gquBQic5BgAWKkopmkXULGPZXm_iN38jGUOF2BOaGRai",
        },
        // HarfBuzz 11.2.1 (MIT) — the optional complex-script shaper. Fetched
        // only when a build asks for it (`-Dharfbuzz=true` /
        // `.harfbuzz = true`); default builds never touch it.
        .harfbuzz = .{
            .url = "https://codeload.github.com/harfbuzz/harfbuzz/tar.gz/refs/tags/11.2.1",
            .hash = "N-V-__8AAIitgQX-ChthNa-95TToUjOgawzsR4ENvt80Btdy",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "shaders",
    },
}
