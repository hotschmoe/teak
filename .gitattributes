# Auto detect text files and perform LF normalization
* text=auto

# Test data parsed byte-for-byte: keep LF on every platform.
src/**/testdata/** -text
tests/fonts/** -text

# Generated by `zig build api` with LF (llms-full.txt embeds llms.txt
# verbatim); the audit compares bytes, so a
# Windows checkout (core.autocrlf=true) must not rewrite them to CRLF.
docs/api.md text eol=lf
llms-full.txt text eol=lf
llms.txt text eol=lf
